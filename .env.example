POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas
POSTGRES_DB=reservas
JWT_SECRET=change-me-in-production
API_PORT=3000
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=admin123
VITE_API_URL=http://localhost:3000

# Solo para "npm run dev" (API corriendo fuera de Docker, contra una Postgres local).
# docker-compose.yml arma su propio DATABASE_URL a partir de POSTGRES_* con host "db"; no uses este valor ahí.
DATABASE_URL=postgres://reservas:reservas@localhost:5432/reservas
